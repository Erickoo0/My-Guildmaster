  dialogueNodes:
  - nodeID: Intro
    dialogueLines:
    - Hi there friend! Welcome to Spellharbor!
    - I've been awaiting you. My name is Edwin.
    - I am your humble and handsome assistant, here to help you with setting up your
      new guild.
    dialogueOptions:
    - optionName: Nice to meet you Edwin.
      targetNodeID: Option1
      optionEvents: []
    - optionName: Edwin? Haven't heard of you.
      targetNodeID: Option2
      optionEvents: []
    nodeEvents: []
    requirements: []
    selectionWeight: 0
    isImportant: 0
  - nodeID: Option1
    dialogueLines:
    - Well then, lets not waste any time.
    - We have a lot of work to do to get this guild up and running.
    dialogueOptions: []
